# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local bug-hunt / probe artifacts
/bug-hunt-artifacts/
/scripts/bug-hunt*.mjs
/scripts/probe-*.mjs

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# bun lockfile — npm is the source of truth (package-lock.json)
bun.lock

# local Classic UI reference (not shipped)
.classic-snapshot/
