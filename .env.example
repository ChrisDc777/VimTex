# Required for OpenRouter free models (/api/chat)
OPENROUTER_API_KEY=

# Optional: OpenCode Zen free models (https://opencode.ai/zen)
# OPENCODE_API_KEY=

# Optional: production app URL for OpenRouter attribution
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional: durable Yjs LevelDB directory (survives server restart)
# YPERSISTENCE=.data/yjs

# Optional: idle GC for empty in-memory rooms (ms). Default 1800000 (30m). 0 = destroy immediately.
# YROOM_IDLE_MS=1800000

# Optional: HMAC secret for read-only view tokens and room auth (required on Cloudflare Worker)
# ROOM_SECRET=change-me-in-production

# Optional: filesystem dir for room metadata (password hash, TTL). Default `.data/rooms`
# ROOM_DATA_DIR=.data/rooms

# Split deploy: Vercel rewrites /api/rooms/* here (server-only, no browser CORS)
# ROOM_SERVICE_ORIGIN=https://vimtex-collab.workers.dev

# Direct Yjs WebSocket host (browser). Required when UI and collab are split.
# NEXT_PUBLIC_COLLAB_WS_URL=wss://vimtex-collab.workers.dev

# Hide/reject "No expiry" TTL in the public beta UI
# NEXT_PUBLIC_HIDE_TTL_NEVER=1
# VIMTEX_TTL_NEVER=0

# Shared-key AI admission (production). Bypass locally unless NODE_ENV=production.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# AI_ADMISSION_SECRET=
# AI_ADMISSION_ORIGIN=https://vimtex-collab.workers.dev

# Optional: auto-start a Cloudflare quick tunnel when the server boots (local / home server)
# Requires cloudflared on PATH. URL changes each restart. Skip if you already have a public host.
# AUTO_TUNNEL=1
# AUTO_TUNNEL_URL=http://127.0.0.1:3001
# CLOUDFLARED_PATH=cloudflared
