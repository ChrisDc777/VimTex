{
  "name": "vimtex",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development HOST=0.0.0.0 PORT=3001 node server.mjs",
    "build": "next build",
    "start": "cross-env NODE_ENV=production HOST=0.0.0.0 PORT=3001 node server.mjs",
    "start:next": "next start -H 127.0.0.1 -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/**/*.test.mjs",
    "test:e2e": "playwright test",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3001"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.27",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@replit/codemirror-vim": "^6.3.0",
    "ai": "^7.0.48",
    "codemirror": "^6.0.2",
    "katex": "^0.18.0",
    "lib0": "^0.2.117",
    "lodash.debounce": "^4.0.8",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "ws": "^8.21.1",
    "y-codemirror.next": "^0.3.5",
    "y-leveldb": "^0.2.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
