{
  "name": "vimtex-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomObject"]
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001",
    "TTL_NEVER_ALLOWED": "true",
    "DEFAULT_TTL_MS": "0",
    "WORKER_VERSION": "dev"
  },
  "env": {
    "staging": {
      "name": "vimtex-collab-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOM",
            "class_name": "RoomObject"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ],
      "vars": {
        "TTL_NEVER_ALLOWED": "false",
        "DEFAULT_TTL_MS": "2592000000",
        "WORKER_VERSION": "staging"
      }
    },
    "production": {
      "name": "vimtex-collab",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOM",
            "class_name": "RoomObject"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ],
      "vars": {
        "TTL_NEVER_ALLOWED": "false",
        "DEFAULT_TTL_MS": "2592000000",
        "WORKER_VERSION": "production"
      }
    }
  }
}
